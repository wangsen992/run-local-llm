{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "purdue-genai": {
      "name": "Purdue GenAI Studio",
      "baseUrl": "https://genai.rcac.purdue.edu/api",
      "api": "openai-completions",
      "apiKey": "${PURDUE_RCAC_GENAI_APIKEY}",
      "authHeader": true,
      "models": [
        {
          "id": "gpt-oss:120b",
          "name": "GenAI GPT-OSS 120B",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 65536,
          "maxTokens": 8192
        },
        {
          "id": "qwen3.8:27b",
          "name": "GenAI Qwen 3.8 27B",
          "input": ["text", "image"],
          "contextWindow": 65536,
          "maxTokens": 8192
        },
        {
          "id": "gemma4:26b-a4b",
          "name": "GenAI Gemma 4 26B A4B",
          "input": ["text", "image"],
          "contextWindow": 65536,
          "maxTokens": 8192
        },
        {
          "id": "llama4:latest",
          "name": "GenAI Llama 4",
          "input": ["text", "image"],
          "contextWindow": 16384,
          "maxTokens": 4096
        }
      ]
    }
  }
}
